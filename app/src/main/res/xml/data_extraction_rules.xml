<?xml version="1.0" encoding="utf-8"?>
<!--
  cloud-backup: gym.db (sohbet, oneriler, antrenman/beslenme), filesDir/chat gorselleri ve sifreli anahtarlar disarida.
  device-transfer (kullanicinin kendi yeni telefonu): <include> verilmedigi icin varsayilan olarak HER SEY aktarilir:
  gym.db (+wal/shm/journal), filesDir/chat gorselleri ve ayarlar. Yalniz Keystore'a bagli sifreli anahtarlar
  (assistant_keys) ve yerel sayac (assistant_usage) disarida: yeni cihazda anahtar yoktur, kullanici yeniden girer.
  (allowBackup=false oldugundan bulut yedegi zaten kapali; kural yine de acik yazildi.)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="gym.db" />
        <exclude domain="database" path="gym.db-wal" />
        <exclude domain="database" path="gym.db-shm" />
        <exclude domain="database" path="gym.db-journal" />
        <exclude domain="file" path="chat/" />
        <exclude domain="sharedpref" path="assistant_keys.xml" />
        <exclude domain="sharedpref" path="assistant_usage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="assistant_keys.xml" />
        <exclude domain="sharedpref" path="assistant_usage.xml" />
    </device-transfer>
</data-extraction-rules>
