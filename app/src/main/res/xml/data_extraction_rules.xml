<?xml version="1.0" encoding="utf-8"?>
<!-- Asistan verisi (sohbet, oneriler, gorseller, sifreli anahtarlar) bulut yedegine ve cihazdan cihaza aktarima girmez. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="gym.db" />
        <exclude domain="database" path="gym.db-wal" />
        <exclude domain="database" path="gym.db-shm" />
        <exclude domain="database" path="gym.db-journal" />
        <exclude domain="file" path="chat/" />
        <exclude domain="sharedpref" path="assistant_keys.xml" />
        <exclude domain="sharedpref" path="assistant_usage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="gym.db" />
        <exclude domain="database" path="gym.db-wal" />
        <exclude domain="database" path="gym.db-shm" />
        <exclude domain="database" path="gym.db-journal" />
        <exclude domain="file" path="chat/" />
        <exclude domain="sharedpref" path="assistant_keys.xml" />
        <exclude domain="sharedpref" path="assistant_usage.xml" />
    </device-transfer>
</data-extraction-rules>
